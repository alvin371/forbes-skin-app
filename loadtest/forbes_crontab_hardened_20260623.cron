* * * * * sleep 6; echo "[$(date '+\%Y-\%m-\%d \%H:\%M:\%S')]" >> /var/log/cron/forbes-update-customer.log && curl --max-time 40 -s -X GET "https://acnenosystem.com/cronjob/update-customer" >> /var/log/cron/forbes-update-customer.log 2>&1
* * * * * sleep 7; echo "[$(date '+\%Y-\%m-\%d \%H:\%M:\%S')]" >> /var/log/cron/forbes-scraping-poll.log && curl --max-time 40 -s -X GET "https://acnenosystem.com/api/cronjob/scraping-poll" >> /var/log/cron/forbes-scraping-poll.log 2>&1
* * * * * sleep 8;  echo "[$(date '+\%Y-\%m-\%d \%H:\%M:\%S')]" >> /var/log/cron/forbes-endorse-refresh.log && curl --max-time 50 -s "https://acnenosystem.com/api/cronjob/endorse-refresh" >> /var/log/cron/endorse-refresh.log 2>&1
* * * * * sleep 28; echo "[$(date '+\%Y-\%m-\%d \%H:\%M:\%S')]" >> /var/log/cron/forbes-endorse-refresh.log && curl --max-time 50 -s "https://acnenosystem.com/api/cronjob/endorse-refresh" >> /var/log/cron/endorse-refresh.log 2>&1
* * * * * sleep 48; echo "[$(date '+\%Y-\%m-\%d \%H:\%M:\%S')]" >> /var/log/cron/forbes-endorse-refresh.log && curl --max-time 50 -s "https://acnenosystem.com/api/cronjob/endorse-refresh" >> /var/log/cron/endorse-refresh.log 2>&1
