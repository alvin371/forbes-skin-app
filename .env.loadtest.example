# =============================================================================
# Endorse-refresh LOAD TEST environment.
#
# Copy to .env.loadtest (git-ignored) and fill in only what you need:
#   cp .env.loadtest.example .env.loadtest
#
# This file is derived from .env.example — it is NOT a copy of production .env and must
# never become one. Every value here is local, disposable, or empty.
#
# docker-compose.loadtest.yml mounts this file at /var/www/html/.env inside the load-test
# containers. That matters: application/helpers/env_helper.php reads FCPATH.'.env' and
# PREFERS it over getenv(), so the mount — not the `environment:` block — is what actually
# takes effect. It also means the load-test containers cannot see the production .env at all.
#
# EndorseRefreshLoadTestGuard refuses to start the worker unless this file proves isolation.
# If a run refuses to start, fix the environment. Never relax the guard.
# =============================================================================

# --- Isolation markers (the guard checks all of these) -----------------------
# 'testing' rather than 'loadtest': index.php's ENVIRONMENT switch has no case for
# 'loadtest' and would exit 503 before CodeIgniter boots.
CI_ENV=testing
# Deliberate opt-in. CI_ENV=testing is shared with the normal test suites, so the worker
# additionally demands this marker before it will spend provider quota.
ENDORSE_REFRESH_LOADTEST=1

# --- Disposable database -----------------------------------------------------
# Container alias from docker-compose.loadtest.yml. From the host use 127.0.0.1.
# The name MUST end in _loadtest — the guard rejects anything else, which is what stops a
# run from ever being aimed at `forbes`.
DB_HOSTNAME=loadtest-mysql
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=loadtest
DB_DATABASE=forbes_loadtest
DB_DRIVER=mysqli

BASE_URL=http://localhost:8090/

# --- Everything outbound is OFF ----------------------------------------------
# Unset rather than "configured but ignored", so a code path that forgets to check a flag
# still cannot reach a real person or a real dashboard.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_CHAT_ID=
FCM_SERVICE_ACCOUNT_FILE=
FCM_PROJECT_ID=
SENTRY_DSN=
LOADTEST_MAIL_DISABLED=true
LOADTEST_WEBHOOKS_DISABLED=true

# --- Provider credentials ----------------------------------------------------
# MOCK RUNS: point RAPIDAPI_HOST at the mock alias and keep the placeholder key below.
# REAL RUNS (staged 1-3 only): set the real RAPIDAPI_HOST and RAPIDAPI_KEY in .env.loadtest,
#   which is git-ignored. Never commit it. Never print it. Never copy the whole production
#   .env to obtain it.
RAPIDAPI_HOST=provider-mock.local
# A non-empty value is REQUIRED even for mock runs. Template::rapidApiConfigError() returns a
# `config` class error whenever host or key is empty, and the fallback leg then fails before a
# socket is opened — which silently leaves the entire fallback path untested while the run
# still reports a healthy throughput number. Any placeholder works against the mock.
RAPIDAPI_KEY=mock-loadtest-key

# Rewrites the direct-scrape host to the mock. Empty = hit the real tiktok.com.
# Only the load-test worker reads this; the production cron path cannot see it.
ENDORSE_REFRESH_MOCK_BASE=https://tiktok-mock.local

# --- Worker: what actually gets tuned between runs ---------------------------
ENDORSE_REFRESH_DRIVER=php_worker
ENDORSE_REFRESH_FETCH_MODE=bhskin_scrape

# In-flight provider requests per worker process. Start at 10; raise only with evidence,
# and never in the same experiment as a rate change.
#   required concurrency ~= 6.67 x avg end-to-end latency in seconds
ENDORSE_REFRESH_MAX_IN_FLIGHT=10

# Claim sizing. The worker claims only up to free slots, so these bound the claim query,
# not the execution width.
ENDORSE_REFRESH_CLAIM_CHUNK_MAX=40
ENDORSE_REFRESH_CLAIM_MIN_BATCH=5

# Which provider goes first. Decided by the Phase 2 leg census, not by taste:
#   avg_requests_per_completion = (2 - pA) / (pA + (1 - pA) * pB)
# direct_scrape first needs pA >= ~0.565 to stay under 1.5.
ENDORSE_REFRESH_LEG_ORDER=direct_scrape,rapidapi
# 1 = single-leg census mode (no fallback). 2 = normal two-leg operation.
ENDORSE_REFRESH_MAX_LEGS=2

ENDORSE_REFRESH_HTTP_TIMEOUT=20
ENDORSE_REFRESH_RAPIDAPI_TIMEOUT=12
ENDORSE_REFRESH_CONNECT_TIMEOUT=5
ENDORSE_REFRESH_LEASE_SEC=120
ENDORSE_REFRESH_RETRY_BASE_SEC=60
ENDORSE_REFRESH_DRAIN_SEC=30
ENDORSE_REFRESH_MAX_RUNTIME_SEC=3600
ENDORSE_REFRESH_ROLLUP_FLUSH_SEC=10
ENDORSE_REFRESH_RECOVERY_MIN_INTERVAL_SEC=5

# --- Request-start rate budget (the ONLY global brake) -----------------------
# The worker passes rate_per_min=0 / daily_cap=0 to claimBatch, because budget belongs at
# request grain, not claim grain. These two numbers are therefore the entire brake.
#
# The guard rejects a non-positive value (reserve() fail-CLOSES there) AND an implausibly
# large one (reserve() fail-OPENS there). Combined must stay <= 720/min.
#   approved: 600/min local test cap, 720/min combined safety ceiling, 800/min provider hard
ENDORSE_REFRESH_DIRECT_RATE_PER_MIN=400
ENDORSE_REFRESH_RAPIDAPI_RATE_PER_MIN=200
ENDORSE_REFRESH_LIMITER_MODE=request_start_reservation

# Ledger retention. Must exceed the ledger flush interval by orders of magnitude, or the
# batched upsert can resurrect a pruned row as a phantom limiter token. Guard floor: 60.
ENDORSE_REFRESH_TOKEN_RETENTION_SEC=3600

# Scope namespacing for the distributed GET_LOCK, so a load test can never contend with a
# real deployment on the same MySQL server.
APP_ENV=loadtest
APP_NAME=forbes-loadtest

# --- Off during load tests ---------------------------------------------------
ENDORSE_ROLLUP_READ=0
ENDORSE_TIKTOK_SCRAPE_ENABLED=0
MONITOR_REQUEST_LOGGING=0
PERMISSION_TABLES_READY=0
ENDORSE_REFRESH_WORKER_REPLICAS=1
