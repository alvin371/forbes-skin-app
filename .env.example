# Database Configuration
DB_HOSTNAME=your_database_host
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_DATABASE=your_database_name
DB_DRIVER=mysqli

# Application Environment
# Options: development, testing, production
CI_ENV=development

# Permission system: set to "true" once the RBAC tables (user_module_permissions,
# modules, roles, role_permissions, user_roles) are provisioned. This skips a
# per-request INFORMATION_SCHEMA probe in the Permission library, removing a
# measurable login/page-load cost. Leave blank/unset on fresh installs so the
# library auto-detects which tables exist.
PERMISSION_TABLES_READY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=1.0

# Base URL (will be auto-detected if not set)
BASE_URL=

# Google OAuth Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_PROJECT_ID=your_google_project_id
GOOGLE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GOOGLE_TOKEN_URI=https://oauth2.googleapis.com/token
GOOGLE_AUTH_PROVIDER_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI_PROD=https://your-domain.com/googlemeet/oauth2callback
GOOGLE_REDIRECT_URI_LOCAL=http://localhost:8888/your-app/oauth2callback

# Google Sheets (Service Account) — for pushing endorse optimization rows to a sheet.
# Create a GCP service account, enable the Google Sheets API, and share the target
# spreadsheet with the service account's client_email as Editor.
#
# Provide the key ONE of two ways (B64 wins if both are set):
#   1) Inline (recommended for Docker/.env-only deploys): base64 of the whole JSON key.
#        base64 -i google-sheets-sa.json | tr -d '\n'
#   2) File path: place the JSON key on the server and point to it.
GOOGLE_SHEETS_CREDENTIALS_B64=
GOOGLE_SHEETS_CREDENTIALS_PATH=application/config/google-sheets-sa.json
GOOGLE_SHEETS_SPREADSHEET_ID=1qdCd6b2FqdjafZ83KC6WaJW-WMSI2Q-j2Q2_e-5F2fQ
GOOGLE_SHEETS_TAB=AUTO_Optimasi

# SMTP Email Configuration
# For sending MOU and notification emails
SMTP_HOST=smtp.your-host.com
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_password
SMTP_PORT_SSL=465
SMTP_PORT_TLS=587

# Telegram Configuration
# Get bot token from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_GROUP_CHAT_ID=your_telegram_group_chat_id
TELEGRAM_PARSE_MODE=HTML

# TikTok Shop API Configuration
# Get credentials from: https://partner.tiktokshop.com/
TIKTOK_APP_KEY=your_tiktok_app_key
TIKTOK_APP_SECRET=your_tiktok_app_secret
# Optional: Rust worker URL for TikTok order sync (default: http://tiktok-worker:8081)
TIKTOK_WORKER_URL=
# TikTok worker mode: node or rust (default: node)
TIKTOK_WORKER_MODE=node
# Optional: Node binary path if not in PATH (default: node)
NODE_BIN=
# Optional: shared secret for worker-to-app API calls
WORKER_SHARED_SECRET=
# Optional: comma-separated IPs allowed to call worker-only endpoints
WORKER_IP_ALLOWLIST=

# Lazada API Configuration
# Get credentials from: https://open.lazada.com/
LAZADA_APP_KEY=your_lazada_app_key
LAZADA_APP_SECRET=your_lazada_app_secret

# Shopee API Configuration
# Get credentials from: https://open.shopee.com/
SHOPEE_PARTNER_ID=your_shopee_partner_id
SHOPEE_PARTNER_KEY=your_shopee_partner_key

# Meta/Facebook API Configuration
# Get credentials from: https://developers.facebook.com/
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# TikTok Business Center API Configuration
# Get credentials from: https://business.tiktok.com/
TIKTOK_BC_APP_ID=your_tiktok_bc_app_id
TIKTOK_BC_APP_SECRET=your_tiktok_bc_app_secret
TIKTOK_BC_ACCESS_TOKEN=your_tiktok_bc_access_token

# RapidAPI Configuration (TikTok Profile/Post Scraping)
# Source of truth: TIKTOK_INTEGRATION_SPEC.md
RAPIDAPI_HOST=tiktok-video-no-watermark10.p.rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key

# ScrapingBot Configuration (Social Media Profile Scraping)
# Get credentials from: https://www.scraping-bot.io/
SCRAPINGBOT_USERNAME=your_scrapingbot_username
SCRAPINGBOT_API_KEY=your_scrapingbot_api_key
SCRAPINGBOT_BASE_URL=http://api.scraping-bot.io

# Endorse refresh queue worker (Api_v2::cronjob_endorse_refresh)
# Per-run claim; with the parallel RapidAPI fan-out the per-minute rate cap is the
# real limiter, so this can be large. Code clamps at 500. Default 10.
ENDORSE_REFRESH_BATCH_SIZE=250
# Concurrent RapidAPI calls per run (curl_multi). Tune up if measured latency > 2s.
# Code clamps 1..20. Default 10.
ENDORSE_REFRESH_PARALLEL_HTTP=10
# Per-minute RapidAPI request cap = this app's share of a pool shared across apps
# (e.g. 250 of a 500/min limit). Bounds the combined rate of all worker runs. 0 = off.
ENDORSE_REFRESH_RATE_PER_MIN=250
# Optional daily RapidAPI request cap per brand (0/unset = off).
ENDORSE_REFRESH_DAILY_CAP=0
# Wall-clock budget per run; keep below curl --max-time and set_time_limit(55). Default 45.
ENDORSE_REFRESH_DEADLINE_SEC=45
# Who drains the queue: 'cron' (per-minute PHP cron, default) or 'rust' (long-lived
# endorse-refresh-worker owns it; the cron stands down but the manual "Proses Sekarang"
# button still runs inline). Flip to 'cron' for instant rollback — claim/apply logic is
# shared, so the fallback is behavior-identical.
ENDORSE_REFRESH_DRIVER=cron
# Rust worker only: in-flight concurrent fetches (isolated HTTP/1.1 connections). Clamped
# 1..50; =1 is strictly sequential. Throughput is still bounded by ENDORSE_REFRESH_RATE_PER_MIN
# (enforced in the /claim endpoint), so this cannot exceed the shared upstream budget.
ENDORSE_REFRESH_CONCURRENCY=10
# Rust worker only: idle sleep (ms) between empty claims. Clamped 250..60000. Default 2000.
ENDORSE_REFRESH_IDLE_SLEEP_MS=2000
# Rust worker only: per-request scrape timeout (s) when the item carries no override.
# Clamped 1..120. Default 30.
ENDORSE_REFRESH_HTTP_TIMEOUT=30
# TikTok page-scrape is unreliable; 0 routes the worker straight to the parallel
# RapidAPI path. Set 1 only if/when the page scrape is fixed. Default 0.
ENDORSE_TIKTOK_SCRAPE_ENABLED=0
# Overview chart reads from endorse_logs_daily_rollup when 1 (keep 0 until backfilled).
ENDORSE_ROLLUP_READ=0

# Google reCAPTCHA v3 Configuration
# Get credentials from: https://www.google.com/recaptcha/admin
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# HRMS API Configuration
API_JWT_SECRET=change-this-secret
API_JWT_TTL_MIN=30
API_REFRESH_TTL_DAYS=30
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# FCM Push (Firebase Cloud Messaging HTTP v1)
# Provide credentials ONE of two ways (B64 takes precedence over FILE):
#  (a) Base64 of the service-account JSON: base64 -w0 service-account.json
FCM_SERVICE_ACCOUNT_B64=your_base64_encoded_service_account_json
#  (b) Easier: path to the raw service-account JSON (absolute, or relative to application/).
#      Keep the file OUTSIDE the web root and gitignored. Leave B64 blank to use this.
FCM_SERVICE_ACCOUNT_FILE=
# Optional — defaults to project_id inside the service-account JSON.
FCM_PROJECT_ID=your_firebase_project_id
# Optional — outbox rows drained per cronjob_notification_dispatch run (default 20, clamp 1-200).
NOTIFICATION_DISPATCH_BATCH=20
# Optional — comma-separated user ids that get an in-app alert when FCM push auth breaks.
# Empty = log-only. Verify FCM anytime with: GET api/fcm/health
FCM_ALERT_USER_IDS=

# FCM Web Push (browser/dashboard client). Public values from Firebase Console >
# Project Settings > General > "Your apps" (Web app config), plus the VAPID public key
# from Cloud Messaging > Web Push certificates. Not secret (they ship to the browser),
# but kept here so they're not hardcoded. Leave FCM_WEB_API_KEY blank to disable web push.
FCM_WEB_API_KEY=
FCM_WEB_AUTH_DOMAIN=hrms-acneno.firebaseapp.com
FCM_WEB_PROJECT_ID=hrms-acneno
FCM_WEB_MESSAGING_SENDER_ID=
FCM_WEB_APP_ID=
FCM_WEB_VAPID_KEY=
