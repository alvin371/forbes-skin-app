# ========================================
# Forbes Skin - Endorse Content Optimization
# ========================================
# Initial/final metric snapshots ride the EXISTING endorse-refresh worker
# (api/cronjob/endorse-refresh). Only the reconcile sweep below is new — it
# re-enqueues a 'final' snapshot for any auto-fetch endorse that is Completed
# but still missing its final metrics (covers enqueues lost after the row
# update committed). Safe to run repeatedly: dedup + frozen guards prevent dupes.

# ========================================
# Every 5 Minutes (*/5 * * * *)
# ========================================

*/5 * * * * echo "[$(date '+\%Y-\%m-\%d \%H:\%M:\%S')]" >> /var/log/cron/forbes-endorse-final-reconcile.log && curl -s -X GET "https://acnenosystem.com/api/cronjob/endorse-final-reconcile" >> /var/log/cron/forbes-endorse-final-reconcile.log 2>&1
