<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="tests/bootstrap.php"
         colors="true"
         cacheResult="false"
         beStrictAboutOutputDuringTests="true"
         failOnWarning="true"
         failOnRisky="true">
