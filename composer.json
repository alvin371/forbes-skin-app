{
    "name": "acneno/forbes-skin-app",
    "description": "Forbes Skin HRMS application",
    "type": "project",
    "license": "proprietary",
    "require": {
        "appolous/lazada-php-sdk": "1.6",
        "firebase/php-jwt": "^6.10",
        "google/apiclient": "^2.18",
        "illuminate/support": "v12.20.0",
        "kint-php/kint": "5.1.1",
        "phpoffice/phpspreadsheet": "^2.4",
        "predis/predis": "v2.4.0",
        "sentry/sentry": "^4.18"
    },
    "require-dev": {
        "codeigniter/coding-standard": "^1.9.2",
        "fakerphp/faker": "v1.24.1",
        "friendsofphp/php-cs-fixer": "^3.95",
        "mikey179/vfsstream": "v1.6.12",
        "nexusphp/cs-config": "^3.28",
        "phpunit/phpunit": "9.6.23"
    },
    "scripts": {
        "lint:syntax": "@php tools/lint.php",
        "lint:style": "php vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --using-cache=no --verbose --path-mode=intersection -- .php-cs-fixer.dist.php application/controllers/HealthController.php migrations/20260818170000_harden_endorse_refresh_claims.php tests tools/lint.php",
        "test": "php vendor/bin/phpunit --configuration phpunit.xml --colors=always",
        "test:unit": "php vendor/bin/phpunit --configuration phpunit.xml --colors=always",
        "test:integration": "php vendor/bin/phpunit -c phpunit-integration.xml --colors=always --testdox",
        "test:e2e": "php vendor/bin/phpunit -c phpunit-integration.xml --colors=always --testdox --filter 'DrainE2E|ApplyIdempotency'",
        "test:all": [
            "@test:unit",
            "@test:integration"
        ],
        "test:integration:docker": "bash tools/run_integration_tests.sh"
    },
     "config": {
        "sort-packages": true,
        "platform": {
        "php": "8.4.0"
        },
        "audit": {
        "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
